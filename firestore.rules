rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isOwner(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    // Guest records use an unguessable random id ("guest-<uuid>"); knowing the
    // document id is what grants a guest access to their own order/request.
    function isGuestId(customerId) {
      return customerId is string && customerId.matches('^guest-[A-Za-z0-9-]{8,}$');
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isTechnician() {
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'technician' ||
        getUserData().role == 'technician'
      );
    }

    // Public / Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      // Allow users to create their own customer record upon signup, but cannot self-assign admin/technician role
      // Self-signup always yields an ACTIVE customer; staff roles are granted by an admin only.
      allow create: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.role == 'customer' &&
        request.resource.data.status == 'ACTIVE' &&
        request.resource.data.get('technicianType', null) == null
      );
      allow update: if isAdmin() || (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'technicianType', 'email', 'id', 'createdAt'])
      );
      allow delete: if isAdmin() || isUser(userId); // in-app account deletion
    }

    // Customers
    match /customers/{userId} {
      allow read, write: if isUser(userId) || isAdmin();
    }

    // Technicians
    match /technicians/{technicianId} {
      allow read: if isUser(technicianId) || isAdmin();
      allow write: if isAdmin() || (
        isUser(technicianId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability', 'updatedAt'])
      );
    }

    // Service Categories & Services (Public Catalog)
    match /serviceCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service Requests
    match /serviceRequests/{requestId} {
      allow get: if isAdmin() ||
        isOwner(resource.data.customerId) ||
        isGuestId(resource.data.customerId) ||
        (isTechnician() && resource.data.assignedTechnicianId == request.auth.uid);
      allow list: if isAdmin() ||
        isOwner(resource.data.customerId) ||
        (isTechnician() && resource.data.assignedTechnicianId == request.auth.uid);
      allow create: if (isOwner(request.resource.data.customerId) || isGuestId(request.resource.data.customerId)) &&
        request.resource.data.status == 'REQUESTED' &&
        request.resource.data.get('assignedTechnicianId', null) == null;
      allow update: if isAdmin() ||
        (isOwner(resource.data.customerId) && (
          (changedOnly(['status', 'updatedAt']) && (
            (request.resource.data.status == 'CANCELLED' &&
              resource.data.status in ['REQUESTED', 'UNDER_REVIEW', 'INSPECTION_SCHEDULED', 'QUOTE_PENDING', 'QUOTE_SENT']) ||
            (request.resource.data.status == 'CUSTOMER_APPROVED' && resource.data.status == 'QUOTE_SENT')
          )) ||
          changedOnly(['preferredSchedule', 'notes', 'updatedAt'])
        )) ||
        (isTechnician() && resource.data.assignedTechnicianId == request.auth.uid &&
          changedOnly(['status', 'updatedAt', 'inspectionId', 'diagnosisFindings', 'technicalDiagnosis', 'partsRequired', 'completedAt']) &&
          request.resource.data.status in ['INSPECTION_SCHEDULED', 'INSPECTION_IN_PROGRESS', 'QUOTE_PENDING', 'IN_PROGRESS', 'WAITING_FOR_PARTS', 'COMPLETED']);
      allow delete: if isAdmin();
    }

    // Inspections
    match /inspections/{inspectionId} {
      allow read: if isAdmin() ||
        (isTechnician() && resource.data.technicianId == request.auth.uid) ||
        (isAuthenticated() && get(/databases/$(database)/documents/serviceRequests/$(resource.data.serviceRequestId)).data.customerId == request.auth.uid);
      allow create: if isAdmin() ||
        (isTechnician() && request.resource.data.technicianId == request.auth.uid);
      allow update: if isAdmin() ||
        (isTechnician() && resource.data.technicianId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Quotes
    match /quotes/{quoteId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(resource.data.customerId) &&
        resource.data.status == 'SENT' &&
        changedOnly(['status', 'acceptedAt', 'rejectedAt', 'updatedAt']) &&
        (request.resource.data.status == 'ACCEPTED' || request.resource.data.status == 'REJECTED')
      );
      allow delete: if isAdmin();
    }

    // Products & Categories
    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Used Products (Sharma Video Care only)
    match /usedProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Source on Request
    match /sourceRequests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.customerId);
      allow create: if isOwner(request.resource.data.customerId) || isGuestId(request.resource.data.customerId);
      allow update: if isAdmin() ||
        (isOwner(resource.data.customerId) && changedOnly(['notes', 'status', 'updatedAt']) &&
          (request.resource.data.status == resource.data.status || request.resource.data.status == 'CANCELLED'));
      allow delete: if isAdmin();
    }

    // Orders — prices and inventory are verified server-side by the onOrderCreated function.
    match /orders/{orderId} {
      allow get: if isAdmin() || isOwner(resource.data.customerId) || isGuestId(resource.data.customerId);
      allow list: if isAdmin() || isOwner(resource.data.customerId);
      allow create: if (isOwner(request.resource.data.customerId) || isGuestId(request.resource.data.customerId)) &&
        request.resource.data.orderStatus in ['PENDING_PAYMENT', 'CONFIRMED'] &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        !request.resource.data.keys().hasAny(['priceVerified', 'priceIssues', 'unverifiedItems', 'inventoryApplied', 'verifiedAt', 'courierDetails']);
      allow update: if isAdmin() ||
        // Bank-transfer proof submitted from the order success page (guests included).
        ((isOwner(resource.data.customerId) || isGuestId(resource.data.customerId)) &&
          changedOnly(['paymentStatus', 'orderStatus', 'updatedAt']) &&
          resource.data.orderStatus == 'PENDING_PAYMENT' &&
          request.resource.data.orderStatus == 'PAYMENT_SUBMITTED' &&
          request.resource.data.paymentStatus == 'PENDING_VERIFICATION') ||
        (isOwner(resource.data.customerId) &&
          changedOnly(['orderStatus', 'updatedAt', 'notes']) && (
            (request.resource.data.orderStatus == 'CANCELLED' &&
              resource.data.orderStatus in ['PENDING_PAYMENT', 'PAYMENT_SUBMITTED', 'CONFIRMED']) ||
            (request.resource.data.orderStatus == 'RETURN_REQUESTED' && resource.data.orderStatus == 'DELIVERED')
          ));
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAdmin() || isOwner(resource.data.customerId);
      allow create: if request.resource.data.status == 'PENDING_VERIFICATION' &&
        (isOwner(request.resource.data.customerId) || isGuestId(request.resource.data.customerId)) &&
        get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.resource.data.customerId;
      allow update: if isAdmin(); // Only Admin can verify payments
      allow delete: if isAdmin();
    }

    // Conversations & Messages (Chat & Live Support)
    // Participants are identified by Firebase Auth uid (anonymous uid for mobile guests).
    function isParticipant(data) {
      return isAuthenticated() && request.auth.uid in data.participantIds;
    }

    function conversationPath(conversationId) {
      return /databases/$(database)/documents/conversations/$(conversationId);
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || isParticipant(resource.data);
      allow create: if isAdmin() || isParticipant(request.resource.data);
      allow update: if isAdmin() || (isParticipant(resource.data) && isParticipant(request.resource.data));
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          !exists(conversationPath(conversationId)) ||
          isParticipant(get(conversationPath(conversationId)).data);
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          (request.resource.data.senderRole == 'customer' || isAdmin() || isTechnician()) &&
          (isAdmin() ||
            isParticipant(getAfter(conversationPath(conversationId)).data));
        allow update, delete: if isAdmin();
      }
    }

    // Top-level Messages (if used as flat collection)
    match /messages/{messageId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && (
          resource.data.senderId == request.auth.uid ||
          request.auth.uid in resource.data.recipientIds
        ));
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid in resource.data.recipientIds && changedOnly(['readBy']));
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAdmin() ||
        resource.data.targetGroup == 'all' ||
        resource.data.userId == 'all' ||
        (resource.data.targetGroup == 'guest' || resource.data.userId == 'guest') ||
        (isAuthenticated() && (
          resource.data.targetGroup == 'users' ||
          resource.data.userId == 'users' ||
          resource.data.userId == request.auth.uid
        ));
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.targetGroup in ['all', 'users', 'guest']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'isRead', 'readBy']));
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
